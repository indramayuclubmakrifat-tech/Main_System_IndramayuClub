const CONFIG = {
  SHEET_ID: 'PASTE_GOOGLE_SHEET_ID_DISINI', // Ganti dengan ID Google Sheet Anda
  SHEET_MEMBER: 'Members',
  SHEET_TRANSAKSI: 'Transaksi'
};

/**
 * Mendapatkan atau membuat spreadsheet berdasarkan CONFIG
 */
function getSpreadsheet() {
  if (CONFIG.SHEET_ID === 'PASTE_GOOGLE_SHEET_ID_DISINI') {
    return SpreadsheetApp.getActiveSpreadsheet();
  }
  return SpreadsheetApp.openById(CONFIG.SHEET_ID);
}

/**
 * ROUTER DOGET (Untuk memuat Halaman HTML atau API Method GET)
 */
function doGet(e) {
  const page = (e && e.parameter && e.parameter.page) || 'index';
  const action = (e && e.parameter && e.parameter.action) || '';

  // 1. ROUTER UNTUK API (Mendapatkan Data JSON)
  if (page === 'api') {
    let result = {};
    
    try {
      if (action === 'members') {
        result = { ok: true, data: getMembersData() };
      } else if (action === 'stats') {
        result = { ok: true, data: getSystemStats() };
      } else {
        result = { ok: false, message: 'Action tidak dikenal' };
      }
    } catch (err) {
      result = { ok: false, error: err.toString() };
    }

    return ContentService.createTextOutput(JSON.stringify(result))
                         .setMimeType(ContentService.MimeType.JSON);
  }

  // 2. ROUTER UNTUK HALAMAN WEB (HTML)
  // Memilih file HTML berdasarkan parameter ?page=nama_file
  let templateName = 'kamus'; // Default halaman utama jika kosong
  if (page === 'android') templateName = 'android';
  if (page === 'halaman2') templateName = 'halaman2';

  try {
    const htmlOutput = HtmlService.createTemplateFromFile(templateName).evaluate();
    return htmlOutput
      .setTitle('Indramayu Club Makrifat Portal')
      .addMetaTag('viewport', 'width=device-width, initial-scale=1.0, maximum-scale=1.0')
      .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  } catch (err) {
    return HtmlService.createHtmlOutput('<h3>Error memuat halaman: ' + err.toString() + '</h3>');
  }
}

/**
 * ROUTER DOPOST (Untuk menerima input data/form/webhook)
 */
function doPost(e) {
  let response = {};
  
  try {
    const postData = JSON.parse(e.postData.contents);
    const action = postData.action;

    if (action === 'register') {
      response = registerMember(postData);
    } else {
      response = { ok: false, message: 'Post action tidak valid' };
    }
  } catch (err) {
    response = { ok: false, error: err.toString() };
  }

  return ContentService.createTextOutput(JSON.stringify(response))
                       .setMimeType(ContentService.MimeType.JSON);
}

// =========================================================================
//                          FUNGSI PEMPROSES DATA
// =========================================================================

/**
 * Mengambil data member dari Google Sheets
 */
function getMembersData() {
  const ss = getSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.SHEET_MEMBER);
  if (!sheet) return [];
  
  const data = sheet.getDataRange().getValues();
  const headers = data[0];
  const rows = data.slice(1);
  
  return rows.map(row => {
    let obj = {};
    headers.forEach((header, index) => {
      obj[header.toLowerCase()] = row[index];
    });
    return obj;
  });
}

/**
 * Mengambil statistik ringkas sistem
 */
function getSystemStats() {
  const members = getMembersData();
  const totalMember = members.length;
  const vvipTerisi = members.filter(m => m.tier && m.tier.toUpperCase() === 'VVIP').length;
  const maxVvip = 50; // Batasan contoh
  
  return {
    totalMember: totalMember,
    vvipTerisi: vvipTerisi,
    vvipSisa: Math.max(0, maxVvip - vvipTerisi)
  };
}

/**
 * Memasukkan member baru ke Google Sheets
 */
function registerMember(data) {
  const ss = getSpreadsheet();
  const sheet = ss.getSheetByName(CONFIG.SHEET_MEMBER);
  if (!sheet) return { ok: false, message: 'Sheet tidak ditemukan' };

  // Generate ID baru secara sederhana
  const nextId = sheet.getLastRow(); 
  
  // Susun baris baru sesuai struktur kolom Sheet Anda (Contoh: ID, Nama, Username, Tier, Saldo, Kota, Daftar)
  const newRow = [
    nextId,
    data.nama || 'Anonymous',
    data.username || '-',
    data.tier || 'REGULAR',
    data.saldo || 0,
    data.kota || 'Indramayu',
    new Date()
  ];
  
  sheet.appendRow(newRow);
  return { ok: true, message: 'Pendaftaran berhasil', id: nextId };
}

/**
 * Helper untuk menyertakan file HTML lain ke dalam template jika diperlukan (include system)
 */
function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}
